# Copia questo file in .env.local (solo sviluppo) oppure imposta le stesse
# variabili nel pannello Vercel: Project > Settings > Environment Variables.
# NON mettere mai la chiave con il prefisso VITE_: finirebbe nel browser.

# Chiave API Gemini (Google AI Studio). Solo lato server.
GEMINI_API_KEY=

# Modello da usare (opzionale). "gemini-flash-latest" punta sempre all'ultimo
# Flash: Google lo aggiorna da solo e avvisa via email 2 settimane prima dei
# cambiamenti incompatibili. Per bloccare una versione scrivi il nome esatto.
GEMINI_MODEL=gemini-flash-latest

# Origini autorizzate a chiamare /api/analyze, separate da virgola (opzionale).
# Se vuoto, accetta solo richieste dallo stesso dominio dell'app.
ALLOWED_ORIGINS=

# Richieste massime per IP al minuto (opzionale, default 8).
RATE_LIMIT_PER_MINUTE=8
