# Parametri delle funzioni. Copia in functions/.env.good-lact (NON va nel repository)
# oppure lascia che `firebase deploy --only functions` te li chieda al primo rilascio.
# La chiave Gemini NON va qui: si imposta come segreto con
#   firebase functions:secrets:set GEMINI_API_KEY --project good-lact

# Email con uso illimitato (separate da virgola). Contano solo se l'email è verificata.
UNLIMITED_EMAILS=

# Richieste con AI al giorno per utente gratuito (analisi piatti + etichette + menu insieme).
FREE_DAILY_LIMIT=10

# Tetto tecnico al giorno anche per gli utenti illimitati (protegge da bug o account violati).
UNLIMITED_DAILY_CAP=500

# Modello Gemini. "gemini-flash-latest" cambia nel tempo: per prezzo stabile scrivi il nome esatto.
GEMINI_MODEL=gemini-flash-latest
